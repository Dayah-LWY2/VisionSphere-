<div id="signupModal" class="login-modal hidden">
    <div class="login-content">
        <img src="/img/forum/logo.png" alt="VisionSphere Logo" class="login-logo" />
        <h2>Sign Up</h2>

        <form id="signupForm">
            <input type="text" id="signupEmail" name="email" placeholder="Email / ID" required />

            <div class="login-links">
                <span>Already in <strong>VisionSphere</strong>? <a href="#" onclick="toggleModals('login')">Log In</a></span>
            </div>

            <button type="submit" class="submit-btn">Continue</button>
        </form>

    </div>
</div>