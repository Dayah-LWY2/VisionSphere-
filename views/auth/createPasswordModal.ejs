<div id="createPasswordModal" class="login-modal hidden">
    <div class="login-content">
        <img src="/img/forum/logo.png" alt="VisionSphere Logo" class="login-logo" />
        <h2>Create Password</h2>

        <form id="createPasswordForm">
            <input type="password" id="newPassword" placeholder="New Password" required />
            <input type="password" id="confirmPassword" placeholder="Confirm Password" required />
            <p class="password-requirements" style="font-size: 0.8em; color: #555; text-align: left; margin-bottom: 10px;">
            Password must be at least 8 characters long and contain:<br>
            - One uppercase letter<br>
            - One lowercase letter<br>
            - One number<br>
            - One symbol
            </p>

            <button type="submit" class="submit-btn">Save Password</button>
        </form>

        <div class="login-links">
            <a href="#" onclick="toggleModals('login')">Back to Login</a>
        </div>
    </div>
</div>