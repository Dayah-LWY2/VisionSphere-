<div id="resetModal" class="login-modal hidden">
    <div class="login-content">
        <img src="/img/forum/logo.png" alt="VisionSphere Logo" class="login-logo" />
        <h2>Reset Password</h2>

        <form id="resetForm">
            <input type="text" id="resetEmail" name="email" placeholder="Email / ID" required />

            <div class="login-links">
                <span>
                    <a href="#" onclick="toggleModals('login')">Back to Log In</a>
                </span>
            </div>

            <button type="submit" class="submit-btn">Send Reset Link</button>
        </form>
    </div>
</div>