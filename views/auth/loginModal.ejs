<div id="loginModal" class="login-modal hidden">
    <div class="login-content">
        <img src="/img/forum/logo.png" alt="VisionSphere Logo" class="login-logo" />
        <h2>Log In</h2>

        <form id="loginForm">
            <input type="text" id="loginEmail" name="email" placeholder="Email / ID" required />
            <input type="password" id="loginPassword" name="password" placeholder="Password" required />

            <div class="login-links">
                <a href="#" onclick="toggleModals('reset')">Forgot Password?</a>
                <span>New to <strong>VisionSphere</strong>? <a href="#" onclick="toggleModals('signup')">Sign Up</a></span>
            </div>

            <button type="submit" class="submit-btn">Log In</button>
        </form>
    </div>
</div>