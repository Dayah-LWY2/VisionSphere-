<div class="container">
    <h2 class="search-title">Search results for "<%= query %>"</h2>

    <% if (posts.length === 0 && communities.length === 0 && users.length === 0) { %>
        <p>No results found.</p>
    <% } %>

    <!-- Communities Section -->
    <% if (communities.length > 0) { %>
        <div class="search-category-container">
            <h3>Communities</h3>
            <div class="search-results-scrollable">
                <% communities.forEach(c => { %>
                    <a href="/community/<%= c.name %>" class="search-card">
                        <img src="<%= c.icon?.filename || '/img/community/icon.jpg' %>" alt="<%= c.name %> Icon" class="community-icon">
                        <div class="community-info">
                            <h3>c/<%= c.displayName || c.name %></h3>
                            <p>
                                <% 
                                    const desc = c.description || 'No description yet.';
                                    const shortDesc = desc.length > 50 ? desc.substring(0, 50) + '...' : desc;
                                %>
                                <%- shortDesc %>
                            </p>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    <% } %>

    <!-- Users Section -->
    <% if (users.length > 0) { %>
        <div class="search-category-container">
            <h3>Users</h3>
            <div class="search-results-scrollable">
                <% users.forEach(user => { %>
                    <% if (user.fullName === '[Deleted User]') { %>
                        <div class="search-card">
                            <img src="<%= user.avatar?.filename || '/img/user/profile.png' %>" alt="<%= user.fullName %> Avatar" class="community-icon">
                            <div class="community-info">
                                <h3><%= user.fullName %></h3>
                                <p><%= user.studentId || user.userId %></p>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/profile/view/<%= user.email %>" class="search-card">
                            <img src="<%= user.avatar?.filename || '/img/user/profile.png' %>" alt="<%= user.fullName %> Avatar" class="community-icon">
                            <div class="community-info">
                                <h3>
                                    <%= user.fullName %>
                                    <!-- User Type Badge -->
                                    <% if (user.userType === 'student') { %>
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/student-dark.png' : '/img/user/student.png' %>" alt="Student Badge" class="user-badge" />
                                    <% } else if (user.userType === 'staff') { %>
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/staff-dark.png' : '/img/user/staff.png' %>" alt="Staff Badge" class="user-badge" />
                                    <% } else if (user.userType === 'lecturer') { %>
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/lecturer-dark.png' : '/img/user/lecturer.png' %>" alt="Lecturer Badge" class="user-badge" />
                                    <% } %>
                                    <!-- Role Badge -->
                                    <% if (user.role === 'moderator') { %>
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/moderator-dark.png' : '/img/user/moderator.png' %>" alt="Moderator Badge" class="moderator-badge" />
                                    <% } else if (user.role === 'admin') { %>
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/admin-dark.png' : '/img/user/admin.png' %>" alt="Admin Badge" class="admin-badge" />
                                    <% } %>
                                </h3>
                                <p><%= user.studentId || user.userId %></p>
                            </div>
                        </a>
                    <% } %>
                <% }) %>
            </div>
        </div>
    <% } %>

    <!-- Posts Section -->
    <% if (posts.length > 0) { %>
        <div class="search-category-container">
            <h3>Posts</h3>
            <div class="search-results-scrollable">
                <div class="community-posts">
                    <% posts.forEach(post => { %>
                        <div class="community-post" id="post-<%= post._id %>">
                            <!-- Post Header -->
                            <div class="post-header">
                                <% if (post.author.fullName === '[Deleted User]') { %>
                                    <img src="<%= post.author.avatar?.filename || '/img/user/profile.png' %>" class="post-avatar" />
                                <% } else { %>
                                    <a href="/profile/view/<%= post.author.email %>">
                                        <img src="<%= post.author.avatar?.filename || '/img/user/profile.png' %>" class="post-avatar" />
                                    </a>
                                <% } %>

                                <div class="post-header-details">
                                    <a href="/community/<%= post.community %>" class="community-link">
                                        c/<%= post.communityDisplayName || post.community %>
                                    </a>
                                    <span>Posted by
                                        <% if (post.author.fullName === '[Deleted User]') { %>
                                            <%= post.author.fullName %>
                                        <% } else { %>
                                            <a href="/profile/view/<%= post.author.email %>">
                                                <%= post.author.fullName %>
                                                <!-- User Type Badge -->
                                                <% if (post.author.userType === 'student') { %>
                                                    <img src="<%= themeClass === 'dark-mode' ? '/img/user/student-dark.png' : '/img/user/student.png' %>" alt="Student Badge" class="user-badge" />
                                                <% } else if (post.author.userType === 'staff') { %>
                                                    <img src="<%= themeClass === 'dark-mode' ? '/img/user/staff-dark.png' : '/img/user/staff.png' %>" alt="Staff Badge" class="user-badge" />
                                                <% } else if (post.author.userType === 'lecturer') { %>
                                                    <img src="<%= themeClass === 'dark-mode' ? '/img/user/lecturer-dark.png' : '/img/user/lecturer.png' %>" alt="Lecturer Badge" class="user-badge" />
                                                <% } %>
                                                <!-- Role Badge -->
                                                <% if (post.author.role === 'moderator') { %>
                                                    <img src="<%= themeClass === 'dark-mode' ? '/img/user/moderator-dark.png' : '/img/user/moderator.png' %>" alt="Moderator Badge" class="moderator-badge" />
                                                <% } else if (post.author.role === 'admin') { %>
                                                    <img src="<%= themeClass === 'dark-mode' ? '/img/user/admin-dark.png' : '/img/user/admin.png' %>" alt="Admin Badge" class="admin-badge" />
                                                <% } %>
                                            </a>
                                        <% } %>
                                    </span>
                                </div>

                                <span class="post-time" data-created-at="<%= post.createdAt %>"></span>

                                <!-- Post Actions Menu -->
                                <% 
                                    const isAuthor = user?.email === post.author?.email;
                                    const isUserAdmin = user?.role === 'admin';
                                    const isUserModerator = user?.role === 'moderator';
                                    const isMember = joinedCommunities?.some(c => c.name === post.community);
                                    const canEdit = isAuthor && (Date.now() - new Date(post.createdAt)) < 3600000;
                                    const canModAdminDelete = (isUserAdmin && post.author?.role !== 'admin') || 
                                                              (isUserModerator && isMember && post.author?.role === 'regular');
                                    const showMenuDot = canEdit || isAuthor || canModAdminDelete;
                                %>
                                <% if (showMenuDot) { %>
                                    <div class="post-actions-menu">
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/forum/menu-dot-dark.png' : '/img/forum/menu-dot.png' %>" alt="Post Menu" class="post-actions-menu-dot">
                                        <div class="post-options-dropdown">
                                            <% if (canEdit) { %>
                                                <a href="/community/<%= post.community %>/edit/<%= post._id %>">Edit Post</a>
                                            <% } %>
                                            <% if (isAuthor) { %>
                                                <form action="/community/<%= post.community %>/post/<%= post._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?')">
                                                    <button type="submit">Delete Post</button>
                                                </form>
                                            <% } else if (canModAdminDelete) { %>
                                                <form action="/community/<%= post.community %>/post/<%= post._id %>/delete" method="POST" onsubmit="return confirmModeratorDelete(this)">
                                                    <input type="hidden" name="reason" />
                                                    <button type="submit">Delete Post</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Post Content -->
                            <a href="/community/<%= post.community %>/post/<%= post._id %>" class="post-preview-link">
                                <div class="post-title"><%= post.title %></div>
                                <% if (post.searchSnippet) { %>
                                    <div class="post-body-preview"><%- post.searchSnippet %></div>
                                <% } else if (post.body) { %>
                                    <div class="post-body-preview"><%- post.body.substring(0, 150) %>...</div>
                                <% } %>
                                <% if (post.media && post.media.length > 0) { %>
                                    <div class="post-media">
                                        <% post.media.forEach(file => { %>
                                            <% if (file.endsWith('.mp4')) { %>
                                                <video src="<%= file %>" controls></video>
                                            <% } else { %>
                                                <img src="<%= file %>" />
                                            <% } %>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </a>

                            <!-- Poll Section -->
                            <% if (post.poll && post.poll.question) { %>
                                <% const hasVoted = user && post.poll.options.some(option => option.votes.includes(user.email)); %>
                                <% const totalVotes = post.poll.options.reduce((sum, option) => sum + option.votes.length, 0); %>
                                <div class="post-poll" id="post-poll-<%= post._id %>" data-community-name="<%= post.community %>">
                                    <p class="poll-question"><%= post.poll.question %></p>
                                    <div class="poll-options">
                                        <% post.poll.options.forEach((option, index) => { %>
                                            <% const userHasVotedForThis = hasVoted && option.votes.includes(user.email); %>
                                            <% const votePercentage = totalVotes > 0 ? ((option.votes.length / totalVotes) * 100).toFixed(0) : 0; %>
                                            <button class="poll-option-btn <%= userHasVotedForThis ? 'voted' : '' %>" data-post-id="<%= post._id %>" data-option-id="<%= index %>" style="--progress: <%= votePercentage %>%;">
                                                <span class="option-text"><%= option.text %></span>
                                                <% if (hasVoted) { %>
                                                    <div class="poll-result-info">
                                                        <span class="vote-count"><%= option.votes.length %> votes</span>
                                                        <span class="vote-percentage">(<%= votePercentage %>%)</span>
                                                    </div>
                                                    <div class="poll-result-bar"></div>
                                                <% } %>
                                            </button>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>

                            <!-- Post Actions (Voting, Reactions) -->
                            <div class="post-actions">
                                <button class="vote-btn upvote <%= post.upvotes.includes(user?.email) ? 'active' : '' %>" data-id="<%= post._id %>" data-vote="up" data-community-name="<%= post.community %>">▲</button>
                                <span class="vote-count upvote-count"><%= post.upvotes.length %></span>
                                <button class="vote-btn downvote <%= post.downvotes.includes(user?.email) ? 'active' : '' %>" data-id="<%= post._id %>" data-vote="down" data-community-name="<%= post.community %>">▼</button>
                                <span class="vote-count downvote-count"><%= post.downvotes.length %></span>
                                <div class="reaction-bar">
                                    <button class="open-emoji-picker" data-post-id="<%= post._id %>" data-community-name="<%= post.community %>">😊</button>
                                    <div class="emoji-picker hidden" id="emoji-picker-<%= post._id %>">
                                        <% const emojiTray = ['❤️', '🤣', '🙏', '👏', '😢', '😮']; %>
                                        <% emojiTray.forEach(emoji => { %>
                                            <% const reacted = post.reactions?.[emoji]?.includes(user?.email); %>
                                            <button class="emoji-btn <%= reacted ? 'selected' : '' %>" data-post-id="<%= post._id %>" data-community-name="<%= post.community %>" data-emoji="<%= emoji %>"><%= emoji %></button>
                                        <% }) %>
                                    </div>
                                </div>
                                <button class="share-btn" data-community-name="<%= post.community %>" data-post-id="<%= post._id %>">
                                    <img src="<%= themeClass === 'dark-mode' ? '/img/forum/share-dark.png' : '/img/forum/share.png' %>" alt="Share" class="nav-icon-img">
                                </button>
                            </div>

                            <!-- Post Reactions Summary -->
                            <% const topReactions = Object.entries(post.reactions || {}).filter(([emoji, users]) => users.length > 0).sort((a, b) => b[1].length - a[1].length).slice(0, 3); %>
                            <div class="post-reactions">
                                <% topReactions.forEach(([emoji, users]) => { %>
                                    <% const userReacted = users.includes(user?.email); %>
                                    <button class="reaction-emoji <%= userReacted ? 'highlight' : '' %>" data-post-id="<%= post._id %>" data-community-name="<%= post.community %>" data-emoji="<%= emoji %>">
                                        <%= emoji %> <%= users.length %>
                                    </button>
                                <% }) %>
                            </div>

                            <!-- Top Comment Preview -->
                            <% if (post.commentSnippet) { %>
                                <a href="/community/<%= post.community %>/post/<%= post._id %>" class="post-preview-link">
                                    <div class="top-comment">
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/forum/comment-dark.png' : '/img/forum/comment.png' %>" alt="Comment" class="comment-icon-preview">
                                        <div class="top-comment-content">
                                            <span class="comment-author">
                                                <% if (post.commentSnippet.author === '[Deleted User]') { %>
                                                    <%= post.commentSnippet.author %>
                                                <% } else { %>
                                                    <%= post.commentSnippet.author %>
                                                    <% if (post.commentSnippet.userType === 'student') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/student-dark.png' : '/img/user/student.png' %>" alt="Student Badge" class="user-badge" />
                                                    <% } else if (post.commentSnippet.userType === 'staff') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/staff-dark.png' : '/img/user/staff.png' %>" alt="Staff Badge" class="user-badge" />
                                                    <% } else if (post.commentSnippet.userType === 'lecturer') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/lecturer-dark.png' : '/img/user/lecturer.png' %>" alt="Lecturer Badge" class="user-badge" />
                                                    <% } %>
                                                    <% if (post.commentSnippet.authorRole === 'moderator') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/moderator-dark.png' : '/img/user/moderator.png' %>" alt="Moderator Badge" class="moderator-badge" />
                                                    <% } else if (post.commentSnippet.authorRole === 'admin') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/admin-dark.png' : '/img/user/admin.png' %>" alt="Admin Badge" class="admin-badge" />
                                                    <% } %>
                                                <% } %>
                                            </span>:
                                            <span class="comment-text"><%= post.commentSnippet.content %></span>
                                        </div>
                                    </div>
                                </a>
                            <% } else if (post.comments && post.comments.length > 0) { %>
                                <a href="/community/<%= post.community %>/post/<%= post._id %>" class="post-preview-link">
                                    <div class="top-comment">
                                        <img src="<%= themeClass === 'dark-mode' ? '/img/forum/comment-dark.png' : '/img/forum/comment.png' %>" alt="Comment" class="comment-icon-preview">
                                        <div class="top-comment-content">
                                            <span class="comment-author">
                                                <% if (post.comments[0].author.fullName === '[Deleted User]') { %>
                                                    <%= post.comments[0].author.fullName %>
                                                <% } else { %>
                                                    <%= post.comments[0].author.fullName %>
                                                    <% if (post.comments[0].author.userType === 'student') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/student-dark.png' : '/img/user/student.png' %>" alt="Student Badge" class="user-badge" />
                                                    <% } else if (post.comments[0].author.userType === 'staff') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/staff-dark.png' : '/img/user/staff.png' %>" alt="Staff Badge" class="user-badge" />
                                                    <% } else if (post.comments[0].author.userType === 'lecturer') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/lecturer-dark.png' : '/img/user/lecturer.png' %>" alt="Lecturer Badge" class="user-badge" />
                                                    <% } %>
                                                    <% if (post.comments[0].author.role === 'moderator') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/moderator-dark.png' : '/img/user/moderator.png' %>" alt="Moderator Badge" class="moderator-badge" />
                                                    <% } else if (post.comments[0].author.role === 'admin') { %>
                                                        <img src="<%= themeClass === 'dark-mode' ? '/img/user/admin-dark.png' : '/img/user/admin.png' %>" alt="Admin Badge" class="admin-badge" />
                                                    <% } %>
                                                <% } %>
                                            </span>:
                                            <span class="comment-text"><%= post.comments[0].content.substring(0, 50) %>...</span>
                                        </div>
                                    </div>
                                </a>
                            <% } %>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    <% } %>
</div>